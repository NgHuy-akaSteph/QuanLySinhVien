<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <EditText
            android:id="@+id/edtMaGVForm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Mã GV (VD: GV001)"
            android:inputType="text"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/edtHoTenForm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Họ tên"
            android:inputType="textPersonName"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/edtHocHamForm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Học hàm"
            android:inputType="text"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/edtHocViForm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Học vị"
            android:inputType="text"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/edtEmailForm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Email"
            android:inputType="textEmailAddress"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/edtDienThoaiForm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Điện thoại"
            android:inputType="phone" />
    </LinearLayout>
</ScrollView>
